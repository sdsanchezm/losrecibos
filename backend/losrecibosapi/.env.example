NODE_ENV=development
PORT=3000
API_PREFIX=api

# Comma-separated browser origins. Leave empty to disable CORS.
# Example: http://localhost:5173,http://localhost:3000
# Use * to allow any origin. Credentials are only enabled for an explicit list.
CORS_ORIGINS=

# PostgreSQL. When DATABASE_URL is set, it replaces PGHOST, PGPORT, PGUSER,
# PGPASSWORD, and PGDATABASE. PGSSLMODE still applies.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=losrecibos

# postgresql://postgres:postgres@localhost:5432/losrecibos
# DATABASE_URL=

# disable | require | verify-ca | verify-full
# Hosted Postgres usually needs require or stricter.
PGSSLMODE=disable
